# Automated tests (pytest). Separate database; fast password hashing; no default-tenant fallback
# so tenant-isolation tests exercise the real hostname resolution.
APP_ENV=test
DATABASE_URL=postgresql+psycopg://school_app:school_app_dev_password@localhost:5432/school_erp_test
LOG_LEVEL=WARNING
PASSWORD_HASH_PROFILE=fast-test
LOGIN_MAX_FAILURES_PER_IP=10000
TENANT_FALLBACK_TO_DEFAULT=false
DEMO_AUTH_MODE=true
