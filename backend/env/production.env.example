# Production TEMPLATE. Do not put real values in the repository: provide them as environment
# variables from your hosting platform's secret store. The app refuses to start if the
# production guards in app/core/config.py are not satisfied.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://<app_role>:<secret>@<host>:5432/<database>
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=__Host-erp_session
CSRF_COOKIE_NAME=__Host-erp_csrf
COOKIE_SECURE=true
ALLOWED_ORIGINS=["https://<school-domain>"]
TENANT_FALLBACK_TO_DEFAULT=false
TRUST_PROXY_HEADERS=true
ENFORCE_PASSWORD_CHANGE=true
DEMO_AUTH_MODE=false
PASSWORD_HASH_PROFILE=standard
