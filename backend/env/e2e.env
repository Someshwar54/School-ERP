# Throwaway backend for Playwright browser tests (scripts/e2e_backend.sh sets ENV_FILE to this file).
APP_ENV=test
DATABASE_URL=postgresql+psycopg://school_app:school_app_dev_password@localhost:5432/school_erp_e2e
LOG_LEVEL=WARNING
PASSWORD_HASH_PROFILE=fast-test
LOGIN_MAX_FAILURES_PER_IP=10000
ALLOWED_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
DEFAULT_SCHOOL_SLUG=demo
TENANT_FALLBACK_TO_DEFAULT=true
DEMO_AUTH_MODE=true
