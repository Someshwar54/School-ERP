# Local development defaults (committed; contains no real secrets).
# Personal overrides go in backend/.env (git-ignored). Real environment variables win over both.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://school_app:school_app_dev_password@localhost:5432/school_erp
LOG_LEVEL=INFO
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEFAULT_SCHOOL_SLUG=demo
TENANT_FALLBACK_TO_DEFAULT=true
TRUST_PROXY_HEADERS=true
ENFORCE_PASSWORD_CHANGE=false
DEMO_AUTH_MODE=true
PASSWORD_HASH_PROFILE=standard
